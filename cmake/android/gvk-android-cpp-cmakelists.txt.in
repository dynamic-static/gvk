
cmake_minimum_required(VERSION 3.30 FATAL_ERROR)
project(@ANDROID_TARGET@)

# NOTE : Generated by gvk_add_android_app() -- do not hand-edit, see
#   gvk/cmake/android.cmake and the call site in samples/CMakeLists.txt; this file is
#   overwritten on the next configure.
#
# NOTE : gvk-system's find_package(game-activity CONFIG) only resolves during a CMake
#   configure that Gradle itself launches (Prefab injects the necessary find paths at
#   that point), so gvk is pulled in as a live subdirectory of *this* configure rather
#   than consumed as a prebuilt install package the way desktop builds do.
@ENABLED_MODULES_BLOCK@
# NOTE : gvk-HOST_BINARY_DIR defaults to a path nested under this configure's own binary
#   directory, which under Gradle's already-deep .cxx/<config>/<hash>/<abi>/ tree pushes
#   the nested host build's own dependencies past Windows' 260-character MAX_PATH.
#   Redirecting it somewhere short and stable also means the nested host-generate build
#   is shared/reused across Android app configures instead of being tied to one Gradle
#   variant's path.
set(gvkSourceDir "@GVK_SOURCE_DIR@")
set(gvk-HOST_BINARY_DIR "${gvkSourceDir}/build-android-host" CACHE PATH "" FORCE)
# NOTE : Same MAX_PATH problem, different victim: FETCHCONTENT_BASE_DIR (where the
#   outer/target build's own FetchContent subbuilds land, eg. VulkanMemoryAllocator).
set(FETCHCONTENT_BASE_DIR "${gvkSourceDir}/build-android-deps" CACHE PATH "" FORCE)
add_subdirectory("${gvkSourceDir}" gvk-build)

set(gvkSamplesDir "${gvkSourceDir}/samples")
add_library(
    @ANDROID_TARGET@
    SHARED
    android-main.cpp
@SOURCE_FILES_BLOCK@
)
target_include_directories(
    @ANDROID_TARGET@
    PRIVATE
@INCLUDE_DIRECTORIES_BLOCK@
)

target_link_libraries(
    @ANDROID_TARGET@
    PUBLIC
@LINK_LIBRARIES_BLOCK@
)

if(VK_NO_PROTOTYPES)
    target_compile_definitions(@ANDROID_TARGET@ PUBLIC VK_NO_PROTOTYPES=1)
endif()
